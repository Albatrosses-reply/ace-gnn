# Validation-selected ACE-GNN configuration (Table 5 of the paper) = the saved run tagged FINAL_L.
# NOTE: three of these differ from the script defaults of src/3_models/ace_v2.py (EXPENC, MP, COLLECTIVE),
# so always pass them explicitly, e.g.
#   set -a; source configs/ace_gnn_final.env; set +a
#   MODE=recent LABEL=severe NSEED=5 python3 src/3_models/ace_v2.py
TAG=FINAL_L
NB=32          # piecewise-linear encoding of the 28 financial ratios: 32 quantile bins
FEMB=12        # 12-d per-feature embedding
BINS=quantile  # quantile knots (BINS=tree = supervised tree-split knots, rejected in Table 8)
USE_EXP=1      # neighbour-exposure features per relation and lag
EXPENC=1       # encode exposures as zero indicator + NEB positive-quantile ramps (script default is 0 = raw)
NEB=8
USE_EXP2=0
LAGS=2         # own history and exposures at t and t-1
TABM=8         # BatchEnsemble members
H=192          # hidden width
ENC_DEPTH=2    # residual blocks
MP=1           # one relation-gated attention layer over the multiplex (script default is 0)
MPKIND=attn
COLLECTIVE=0   # collective inference evaluated and excluded (Table 8; script default is 1)
HIER=free      # free per-level auditor weights
LR=1e-3
WD=3e-5
DROP=0.15
POSW_SQRT=1    # class-weighted BCE with square-root positive weight
EPMAX=400
MTL=0
RANKW=0
THREADS=3
# NSEED=5 for recent/severe and recent/any, NSEED=4 for panel/severe (set on the command line)
